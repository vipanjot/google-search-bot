# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit it.

# Optional: override the scraped articles directory
SCRAPED_DIR=scraped-articles

# Optional: override the saved-articles JSON file path
SAVED_FILE=saved_articles.json

# Set to "true" to automatically git-push after each scrape run
AUTO_GIT_PUSH=false

# Optional: cap how long a single bot run can take (seconds)
BOT_TIMEOUT=300

# Google Custom Search — only needed when using --engine google
# Get a free key at: https://developers.google.com/custom-search/v1
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX=your_custom_search_engine_id_here
